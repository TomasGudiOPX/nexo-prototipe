# Deployment fallback for the RAGFlow connection. NEXO uses these values until a
# site administrator saves a runtime override in /admin/; they are never sent to browsers.
RAGFLOW_BASE_URL=http://ragflow-backend:9380
# NEXO and the in-repository RAGFlow backend use this server-side key.
# The backend creates the key for the bootstrap tenant on its first start.
RAGFLOW_API_KEY=replace-with-a-unique-ragflow-api-key

# Map each dataset ID to the chat ID configured for that dataset.
RAGFLOW_DATASET_CHAT_IDS={"dataset-id":"chat-id"}

# NEXO site administrator; used to seed the initial NEXO and RAGFlow admin.
NEXO_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
NEXO_BOOTSTRAP_ADMIN_NAME=Site Administrator
NEXO_RAGFLOW_SERVICE_EMAIL=nexo-api@internal.nexo
NEXO_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password
NEXO_SESSION_SECRET=replace-with-64-random-hex-characters
NEXO_ENCRYPTION_KEY=replace-with-64-random-hex-characters

# NEXO_ENCRYPTION_KEY is required for encrypted runtime API-key overrides. Keep
# it stable: changing it makes saved overrides unreadable until they are cleared.

# Private dependency services for the selected RAGFlow Go backend. Replace
# every placeholder with a different random secret before deployment.
MYSQL_PASSWORD=replace-with-a-unique-random-secret
MYSQL_ROOT_PASSWORD=use-the-same-value-as-MYSQL_PASSWORD
ELASTIC_PASSWORD=replace-with-a-unique-random-secret
MINIO_USER=rag_flow
MINIO_ROOT_USER=use-the-same-value-as-MINIO_USER
MINIO_PASSWORD=replace-with-a-unique-random-secret
MINIO_ROOT_PASSWORD=use-the-same-value-as-MINIO_PASSWORD
REDIS_PASSWORD=replace-with-a-unique-random-secret
CLICKHOUSE_USER=ragflow
CLICKHOUSE_PASSWORD=replace-with-a-unique-random-secret

# Optional published NEXO port (browser-facing); the RAGFlow service ports stay private.
NEXO_PORT=3000
