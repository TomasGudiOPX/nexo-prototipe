# Server-only RAGFlow connection. Never expose these values with a VITE_ prefix.
RAGFLOW_BASE_URL=http://localhost:9380
# URL used from inside the NEXO container; override for an external host if needed.
RAGFLOW_BASE_URL_DOCKER=http://host.docker.internal:9380
RAGFLOW_API_KEY=replace-with-ragflow-api-key

# Map each dataset ID to the chat ID configured for that dataset.
RAGFLOW_DATASET_CHAT_IDS={"dataset-id":"chat-id"}

# Browser-facing admin UI URL (optional, separate from the server API URL).
RAGFLOW_ADMIN_URL=http://localhost:80
